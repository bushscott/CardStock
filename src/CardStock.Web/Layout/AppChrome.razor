@* Sticky global nav — card.md §1 Chrome. Home/Screener/Charts/Binder/search/avatar stay
   deferred-disabled in Phase 2 (global constraint: present, honest tooltip, never a dead
   link or a stripped control). Browse went live in Task 23 (D-110's Catalog phase): a real
   anchor, lit active on /browse and its descendant catalog routes /set/* and /character/*
   -- shared-components.md:66-68, "descendant pages light the ancestor tab" -- while the
   Card screen marks nothing active (card.md:41, a leaf, not a tab). The logo lockup's Home
   link is itself deferred, so it still renders as an inert span rather than an anchor. *@
@implements IDisposable
@inject NavigationManager Nav

<nav class="app-chrome">
    <span class="logo-lockup">
        <AppLogo />
        <span class="wordmark">Cardstock</span>
    </span>

    <div class="tabs">
        <DeferredControl Label="Home" Tooltip="Home arrives in a later phase" CssClass="tab" />
        <DeferredControl Label="Screener" Tooltip="The Screener arrives in a later phase" CssClass="tab" />
        <DeferredControl Label="Charts" Tooltip="Charts arrives in a later phase" CssClass="tab" />
        <DeferredControl Label="Binder" Tooltip="The Binder arrives in a later phase (Phase 4)" CssClass="tab" />
        <a class="tab @(IsCatalogRoute() ? "active" : null)" href="browse"
           title="Browse every set and species we track">Browse</a>
    </div>

    <div class="spacer"></div>

    <input type="search" class="search-input deferred" disabled aria-disabled="true"
           title="Search arrives in a later phase" placeholder="Search" />

    <DeferredControl Label="O" Tooltip="Accounts arrive with the Binder phase" CssClass="avatar" />
</nav>

@code {
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private bool IsCatalogRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        return path.StartsWith("browse", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("set/", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("character/", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
