@* card.md §2.6 (right panel) / §3.9, amended by D-093 (owner, 2026-08-13): the two
   metric slots render whatever state the wire computed — the engine evaluates the
   card's own observation history read-time behind per-metric data checks, so each
   slot flips from LOW DATA to its computed sentence the moment its data qualifies,
   with no further deploy. LOW DATA keeps D-087's form: the warn chip plus a note
   naming the rule and when it passes. Ok renders the headline value plus the
   sentence as toned segments — colour rides market meaning, and the words carry it
   without the colour (never colour alone). This component never computes: the
   header can never disagree with the wire. *@
@using CardStock.Application.Cards

<div class="activity-panel">
    <div class="activity-header">
        <h2>Grading activity · PSA 10 slabs added</h2>
        <span class="obs-badge" title="@BadgeTooltip()">@(Census.QualifyingObservations) OBS</span>
    </div>
    @* D-094: the ghost delta chart -- seven month slots ending at the current month.
       A slot materializes as a filled, scaled bar once its month closed and the data
       qualifies; until then it renders a dashed ghost with NO number (rule 2: a ghost
       may never read as data) and a tooltip naming its unlock. The current month is
       always the trailing ghost -- the outlined partial month OQ-10 anticipated. *@
    <div class="ga-bars">
        @foreach (var bar in Census.DeltaBars)
        {
            <div class="ga-bar-col">
                @if (bar.State == "observed")
                {
                    <span class="ga-bar-value">@DeltaText(bar.Delta!.Value)</span>
                    <div class="ga-bar ga-bar-observed" style="height: @(BarHeight(bar.Delta.Value))px;" title="@bar.Tooltip"></div>
                }
                else
                {
                    <div class="ga-bar ga-bar-pending" title="@bar.Tooltip"></div>
                }
                <span class="ga-bar-label">@bar.Label</span>
            </div>
        }
    </div>
    @foreach (var metric in Census.Metrics)
    {
        <div class="ga-metric">
            <span class="ga-metric-name">@metric.Name</span>
            @if (metric.State == "ok")
            {
                <span class="ga-metric-value">@metric.Value</span>
                <span class="ga-metric-note">
                    @foreach (var segment in metric.Segments)
                    {
                        <span class="ga-seg-@segment.Tone">@segment.Text</span>
                    }
                </span>
            }
            else
            {
                <span class="ga-state">LOW DATA</span>
                <span class="ga-metric-note">@string.Concat(metric.Segments.Select(s => s.Text))</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public CensusDto Census { get; set; } = default!;

    private string BadgeTooltip() =>
        $"Census observations counted from {Dates.Full(new DateOnly(2026, 9, 1))} — {Census.QualifyingObservations} so far; deltas need two.";

    // §3.9's maxD rule, observed bars only: the tallest reaches 104+4; a
    // restated-down (≤ 0) month keeps the 4px stub with its true value above.
    private int Max => Census.DeltaBars
        .Where(b => b.State == "observed" && b.Delta > 0)
        .Select(b => b.Delta!.Value)
        .DefaultIfEmpty(0)
        .Max();

    private int BarHeight(int delta)
    {
        var max = Max;
        return delta <= 0 || max == 0 ? 4 : (int)(Math.Round(delta / (decimal)max * 104) + 4);
    }

    // The prototype's `'+' + n` value form with the true minus: +42 / +0 / −4.
    private static string DeltaText(int delta) =>
        delta >= 0 ? $"+{delta}" : $"−{Math.Abs(delta)}";
}
