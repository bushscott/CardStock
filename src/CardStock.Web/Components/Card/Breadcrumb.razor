@* Card page breadcrumb — card.md Layout block #0, Interactions §5.1: "Browse / {SetName} / {CardTitle}".
   Both ancestor crumbs are live links (D-122): Browse at /browse, the set at /set/{id} — the
   set crumb's inert-span era ended when the identity wire gained SetId. The leaf crumb is
   plain --ink text, not a link (card.md §5.1 item 5). *@
<div class="breadcrumb">
    <a class="crumb-link" href="browse">Browse</a>
    <span class="crumb-sep">›</span>
    <a class="crumb-link" href="set/@SetId">@SetName</a>
    <span class="crumb-sep">›</span>
    <span class="crumb-leaf">@CardTitle</span>
</div>

@code {
    [Parameter]
    public long SetId { get; set; }

    [Parameter]
    public string SetName { get; set; } = "";

    [Parameter]
    public string CardTitle { get; set; } = "";
}
