@* card.md §2.5/§3.7/§4.4-§4.6/§5.5: the raw per-sale ledger. Null Sales is the panel's own
   error state (CardApiClient.GetSalesAsync returns null on a failed fetch) so one bad call
   never blanks the rest of the card page. Grade-bucket text and the Listing-title cell are
   interpolated as plain Razor content -- never MarkupString -- so hostile marketplace text
   (R-36/D-029) is always HTML-encoded, in both the cell text and its title attribute. *@
@using CardStock.Application.Cards
@using CardStock.Web.Ledger
@using CardStock.Web.Services
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IJSRuntime JS
@implements IDisposable

@if (Sales is null)
{
    <div class="ledger-panel lg-error">
        <p>Couldn't load the sales ledger.</p>
        <button type="button" class="lg-retry" @onclick="Retry">Retry</button>
    </div>
}
else
{
    <div class="ledger-panel">
        <div class="lg-toolbar">
            <h2>Sales ledger</h2>
            <div class="lg-chips">
                <button type="button" class="lg-chip @(_state.Selected.Count == 0 ? "lg-chip-sel" : "")"
                        title="Show sales from every grade" @onclick="SelectAll">All</button>

                @{ var psa10 = LedgerVocabulary.DirectChips[0]; }
                <button type="button" class="lg-chip @(SelClass(psa10))" data-bucket="@psa10"
                        title="@ChipTooltip(psa10)" @onclick="() => ToggleBucket(psa10)">@psa10</button>

                <div class="lg-group" data-lg-pop @onmouseleave="CloseGroups">
                    <button type="button" class="lg-chip @(GroupClass(LedgerVocabulary.OtherTens, _tensOpen))"
                            title="Filter the ledger to other graders' 10s — click to pick individual graders"
                            @onclick="ToggleTensGroup">@GroupLabel(LedgerVocabulary.OtherTens, "other 10s", _tensOpen)</button>
                    @if (_tensOpen)
                    {
                        <div class="lg-popover">
                            <div class="lg-pop-header">Other graders' 10s</div>
                            @foreach (var bucket in LedgerVocabulary.OtherTens)
                            {
                                <button type="button" class="lg-subchip @(SelClass(bucket))" data-bucket="@bucket"
                                        title="@ChipTooltip(bucket)" @onclick="() => ToggleBucket(bucket)">@LedgerVocabulary.Display(bucket)</button>
                            }
                        </div>
                    }
                </div>

                @foreach (var bucket in LedgerVocabulary.DirectChips.Skip(1).Take(4))
                {
                    <button type="button" class="lg-chip @(SelClass(bucket))" data-bucket="@bucket"
                            title="@ChipTooltip(bucket)" @onclick="() => ToggleBucket(bucket)">@LedgerVocabulary.Display(bucket)</button>
                }

                <div class="lg-group" data-lg-pop @onmouseleave="CloseGroups">
                    <button type="button" class="lg-chip @(GroupClass(LedgerVocabulary.GradesOneToSix, _lowsOpen))"
                            title="Filter the ledger to grades 1–6 — click to pick individual grades"
                            @onclick="ToggleLowsGroup">@GroupLabel(LedgerVocabulary.GradesOneToSix, "Grades 1–6", _lowsOpen)</button>
                    @if (_lowsOpen)
                    {
                        <div class="lg-popover">
                            <div class="lg-pop-header">Grades 1–6</div>
                            @foreach (var bucket in LedgerVocabulary.GradesOneToSix)
                            {
                                <button type="button" class="lg-subchip @(SelClass(bucket))" data-bucket="@bucket"
                                        title="@ChipTooltip(bucket)" @onclick="() => ToggleBucket(bucket)">@LedgerVocabulary.Display(bucket)</button>
                            }
                        </div>
                    }
                </div>

                @{ var raw = LedgerVocabulary.DirectChips[^1]; }
                <button type="button" class="lg-chip @(SelClass(raw))" data-bucket="@raw"
                        title="@ChipTooltip(raw)" @onclick="() => ToggleBucket(raw)">@LedgerVocabulary.Display(raw)</button>
            </div>
            <span class="lg-count"
                  title="Each grade is complete from its own first captured sale; nothing earlier was observable.">@Filtered.Count sales shown</span>
        </div>

        <div class="lg-row lg-header" style="grid-template-columns:@GridTemplate()">
            @* @(Arrow(...)) not @Arrow(...): an @ between word characters ("Date@Arrow")
               hits Razor's email-address heuristic and renders as literal text. *@
            <span class="lg-h" title="Click to sort" @onclick='() => SortBy("date")'>Date@(Arrow("date"))</span>
            <span class="lg-grip" @onmousedown='e => StartDrag("date", e)'></span>
            <span class="lg-h" title="Click to sort" @onclick='() => SortBy("bucket")'>Grade bucket@(Arrow("bucket"))</span>
            <span class="lg-grip" @onmousedown='e => StartDrag("bucket", e)'></span>
            <span class="lg-h" title="Click to sort" @onclick='() => SortBy("price")'>Realized@(Arrow("price"))</span>
            <span class="lg-grip" @onmousedown='e => StartDrag("price", e)'></span>
            <span class="lg-h" title="Click to sort" @onclick='() => SortBy("src")'>Source@(Arrow("src"))</span>
            <span class="lg-grip" @onmousedown='e => StartDrag("src", e)'></span>
            <span class="lg-h" title="Click to sort" @onclick='() => SortBy("title")'>Listing title@(Arrow("title"))</span>
        </div>

        @if (Filtered.Count == 0)
        {
            <div class="lg-empty">@EmptyStateCopy()</div>
        }
        else
        {
            <Virtualize Items="Filtered" ItemSize="32" Context="row">
                <div class="lg-row lg-body" style="grid-template-columns:@GridTemplate()">
                    <span class="lg-date">@row.SoldOn.ToString("yyyy-MM-dd")</span>
                    <span class="lg-bucket">@LedgerVocabulary.Display(row.GradeTier)</span>
                    <span class="lg-price @(row.ListedPriceCents is not null ? "lg-listed" : "")"
                          title="@ListedTooltip(row)">@Format.Money(row.PriceCents)</span>
                    <span class="lg-src">@row.Source</span>
                    <span class="lg-title" title="@row.Title">@row.Title</span>
                </div>
            </Virtualize>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<SaleDto>? Sales { get; set; }
    [Parameter] public EventCallback Retry { get; set; }

    private readonly LedgerState _state = new();
    private readonly string _instanceId = $"sales-ledger-{Guid.NewGuid():N}";
    private bool _tensOpen;
    private bool _lowsOpen;
    private double _dateW = 96, _bucketW = 108, _priceW = 92, _srcW = 92;
    private DotNetObjectReference<SalesLedger>? _dotNetRef;

    private List<SaleDto> Filtered { get; set; } = [];

    protected override void OnParametersSet()
    {
        if (Sales is not null)
        {
            Filtered = _state.Apply(Sales).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("watchOutsideMousedown", _instanceId, "[data-lg-pop]", _dotNetRef);
        }
    }

    /// <summary>Mirrors PriceChart's Dispose (task-17): every mounted instance registered a
    /// permanent `document` mousedown listener in OnAfterRenderAsync above, so without this,
    /// ordinary card-to-card navigation -- which tears down and rebuilds SalesLedger on every
    /// Id change (CardPage.LoadAsync nulls _result synchronously) -- leaks one listener and one
    /// DotNetObjectReference per card visited.</summary>
    public void Dispose()
    {
        _dotNetRef?.Dispose();
        _ = JS.InvokeVoidAsync("unwatchOutsideMousedown", _instanceId);
    }

    private void Recompute() => Filtered = _state.Apply(Sales!).ToList();

    private void SelectAll()
    {
        _state.ClearAll();
        _tensOpen = false;
        _lowsOpen = false;
        Recompute();
    }

    private void ToggleBucket(string bucket)
    {
        _state.Toggle(bucket);
        Recompute();
    }

    private void ToggleTensGroup()
    {
        _tensOpen = !_tensOpen;
        if (_tensOpen)
        {
            _lowsOpen = false;
        }
    }

    private void ToggleLowsGroup()
    {
        _lowsOpen = !_lowsOpen;
        if (_lowsOpen)
        {
            _tensOpen = false;
        }
    }

    /// <summary>Group wrapper mouseleave (card.md §4.4/§5.5 #28) -- closes both group popovers.
    /// [JSInvokable] and public so the outside-mousedown JS helper (site.js) can call it too;
    /// directly callable from bUnit without a real JS runtime, mirroring PriceChart's
    /// OnCrosshairMonth convention (task-17).</summary>
    [JSInvokable]
    public void CloseGroups()
    {
        _tensOpen = false;
        _lowsOpen = false;
        StateHasChanged();
    }

    private void SortBy(string key)
    {
        _state.Sort(key);
        Recompute();
    }

    private string SelClass(string bucket) => _state.Selected.Contains(bucket) ? "lg-chip-sel" : "";

    private bool GroupPillActive(IReadOnlyList<string> members, bool open) =>
        open || members.Any(_state.Selected.Contains);

    private string GroupClass(IReadOnlyList<string> members, bool open) =>
        GroupPillActive(members, open) ? "lg-chip-sel" : "";

    private string GroupLabel(IReadOnlyList<string> members, string baseLabel, bool open)
    {
        var selected = members.Where(_state.Selected.Contains).Select(LedgerVocabulary.Display).ToList();
        var label = selected.Count > 0 ? string.Join(", ", selected) : baseLabel;
        return label + (open ? " ▾" : " ▸");
    }

    private string ChipTooltip(string bucket) =>
        (_state.Selected.Contains(bucket) ? "Stop filtering the ledger to " : "Filter the ledger to ")
        + LedgerVocabulary.Display(bucket) + " sales";

    private string Arrow(string key) =>
        _state.SortKey != key ? "" : _state.Descending ? " ▾" : " ▴";

    private string EmptyStateCopy() => _state.Selected.Count switch
    {
        0 => "No sales observed for this card — that's a true zero: our scrapers visited and found none.",
        1 => "No sales observed in this grade — that's a true zero: our scrapers visited and found none.",
        _ => "No sales observed in these grades — that's a true zero: our scrapers visited and found none.",
    };

    private static string ListedTooltip(SaleDto row) => row.ListedPriceCents is int listed
        ? $"listed {Format.Money(listed)} → sold {Format.Money(row.PriceCents)}"
        : "";

    private string GridTemplate() => $"{_dateW}px {_bucketW}px {_priceW}px {_srcW}px minmax(160px, 1fr)";

    private double WidthOf(string key) => key switch
    {
        "date" => _dateW,
        "bucket" => _bucketW,
        "price" => _priceW,
        _ => _srcW,
    };

    /// <summary>Header resize grip mousedown (card.md §5.5 #31, R-7: clamp 40-420). Grips exist
    /// only on columns 1-4 (date/bucket/price/src) -- the title column's mis-wired grip
    /// (OQ-6/I-3) is removed entirely, not just rewired.</summary>
    private async Task StartDrag(string key, MouseEventArgs e)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("startColumnDrag", _dotNetRef, key, WidthOf(key), e.ClientX);
    }

    [JSInvokable]
    public void SetColumnWidth(string key, double widthPx)
    {
        var clamped = Math.Clamp(widthPx, 40, 420);
        switch (key)
        {
            case "date": _dateW = clamped; break;
            case "bucket": _bucketW = clamped; break;
            case "price": _priceW = clamped; break;
            case "src": _srcW = clamped; break;
        }

        StateHasChanged();
    }
}
