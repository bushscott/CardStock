@* card.md §2.1-§2.2: art column + right column. §2.2 amended 2026-08-13 (D-092):
   Rows B and C became one wrapping row -- the 3×2 tier tile grid and the Signals
   panel, stretched to equal heights. §4.2.1 (D-077) keeps the fixed 28px full-width
   badge slot between row-a and that row, never a flex sibling beside the title
   (Task 16 review finding, carried into Task 20, which wires RefreshBadge into it).

   §3.1.1 (D-079, D-084.10, amended by D-087): all three subline slots render. The set
   name is a real destination that doesn't exist yet, so it renders through the same
   deferred-disabled treatment as every other not-yet-built control (Task 14 review
   finding, carried into this task) -- never plain text. The character segment has no
   species field behind it yet, so its slot holds the D-087 placeholder label in the
   pending tone -- self-evidently not data -- until the Pokédex phase's tag table
   supplies real names. A name is never guessed from the title string.

   Row A's actions (Open in Charts / watchlist / binder) reuse the exact label and
   tooltip strings Task 15 already put on record in ChromeTests.DeferredTooltips, so
   this is the second and only other place those strings are typed. *@
@using CardStock.Application.Cards
@using CardStock.Web.Services

<div class="card-identity-panel">
    <button type="button" class="art-col" title="Click to enlarge" disabled="@(!Identity.HasImage)" @onclick="OpenLightbox">
        @if (!Identity.HasImage || _imageFailed)
        {
            <div class="art-placeholder">card art pending</div>
        }
        else
        {
            <img id="card-art-thumb" src="@CardApiClient.ImageUrl(CardId)" alt="@Identity.Title" @onerror="OnImageError" />
        }
    </button>

    <div class="right-col">
        <div class="row-a">
            <div class="title-block">
                <h1>@Identity.Title</h1>
                <p class="subline">
                    <DeferredControl Label="@Identity.SetName" Tooltip="@Breadcrumb.SetTooltip" CssClass="subline-set" />
                    @if (NumberSegment() is { } number)
                    {
                        <span class="subline-number">@number</span>
                    }
                    <span class="subline-dot" aria-hidden="true">·</span>
                    <DeferredControl Label="Pokémon name"
                                     Tooltip="The Pokémon's name arrives with the Pokédex phase"
                                     CssClass="subline-character" />
                </p>
                <DelistedChip DelistedAt="@Identity.DelistedAt" />
            </div>

            <div class="row-a-actions">
                <div class="actions-row">
                    <DeferredControl Label="Open in Charts →" Tooltip="Charts arrives in a later phase" CssClass="btn-open-charts" />
                    <DeferredControl Label="+ Watchlist ▾" Tooltip="Watchlists arrive with accounts, in a later phase" CssClass="btn-watchlist" />
                    <DeferredControl Label="+ Binder" Tooltip="The Binder arrives in Phase 4" CssClass="btn-binder" />
                </div>
                @* D-097: the badge reservation lives under the buttons now -- the dedicated
                   full-width row surrendered its 52px so the header reads as one solid block.
                   Still a fixed 28px slot (D-077: nothing jumps when the badge appears). *@
                <div class="badge-slot">@BadgeSlot</div>
            </div>
        </div>

        <div class="tiles-and-signals">
            <TierStrip Prices="@Prices" />
            <SignalsPanel Signals="@Signals" />
        </div>
    </div>

    @if (_lightboxOpen)
    {
        <Lightbox CardId="@CardId" Title="@Identity.Title" OnClose="CloseLightbox" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IdentityDto Identity { get; set; } = default!;

    [Parameter]
    public long CardId { get; set; }

    [Parameter, EditorRequired]
    public PricesDto Prices { get; set; } = default!;

    [Parameter]
    public SignalsDto Signals { get; set; } = new(0, 0, []);

    /// <summary>The reserved 28px slot's content -- CardPage supplies a RefreshBadge
    /// here (task 20). Empty renders as a blank row; the reservation is CSS
    /// (.badge-slot), not conditional on this fragment being set.</summary>
    [Parameter]
    public RenderFragment? BadgeSlot { get; set; }

    private bool _imageFailed;
    private bool _lightboxOpen;

    private void OnImageError() => _imageFailed = true;

    // I3: HasImage false means the source never had art for this card, so the placeholder
    // already rendered above with no <img>, no 404 round-trip. This guard keeps the lightbox
    // from opening even if a click somehow reaches the handler regardless of the button's
    // `disabled` attribute (e.g. a test harness that does not enforce real-browser disabled
    // semantics) -- there is nothing for it to show.
    private void OpenLightbox()
    {
        if (Identity.HasImage)
        {
            _lightboxOpen = true;
        }
    }

    private void CloseLightbox() => _lightboxOpen = false;

    // card.md §3.1.1: number segment stays plain text -- omitted when the source
    // hasn't parsed a collector number, "#num" until the TCGdex enrichment lands a
    // SetSize, "num/size" after.
    private string? NumberSegment() =>
        Identity.CollectorNumber is null ? null :
        Identity.SetSize is { } size ? $"· {Identity.CollectorNumber}/{size}" : $"· #{Identity.CollectorNumber}";
}
