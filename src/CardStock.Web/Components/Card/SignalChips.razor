@* card.md §2.2 Row C / §3.3: one chip per signal, cap 4 visible with a "+N more"
   overflow that reveals every remaining chip (never replaces the first four). An
   empty list renders the row container with nothing in it -- zero height follows
   from having no children, not a separate empty-state message. *@
@using CardStock.Application.Cards

<div class="chip-row">
    @foreach (var chip in Chips.Take(4))
    {
        <span class="chip chip-@chip.Tone" tabindex="0" title="@chip.Tooltip">@chip.Glyph @chip.Text</span>
    }
    @if (Chips.Count > 4)
    {
        <button type="button" class="chip-more" @onclick="TogglePopover">+@(Chips.Count - 4) more</button>
        @if (_popoverOpen)
        {
            <div class="chip-popover">
                @foreach (var chip in Chips.Skip(4))
                {
                    <span class="chip chip-@chip.Tone" tabindex="0" title="@chip.Tooltip">@chip.Glyph @chip.Text</span>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ChipDto> Chips { get; set; } = Array.Empty<ChipDto>();

    private bool _popoverOpen;

    private void TogglePopover() => _popoverOpen = !_popoverOpen;
}
