[Unit]
Description=CardStock API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cardstock
WorkingDirectory=/opt/cardstock/api
ExecStart=/opt/cardstock/api/CardStock.Api
Restart=always
RestartSec=10
Environment=ASPNETCORE_ENVIRONMENT=Production

# Hardening, per D-037. MemoryMax matters most: this box also runs the crawler
# and PostgreSQL, and the web tier must not be able to starve either.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=2G
# 443 is a privileged port; this grants exactly the low-port bind and nothing
# else, and composes with NoNewPrivileges (D-132 checklist B).
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
