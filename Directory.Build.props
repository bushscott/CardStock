<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Deliberately NOT InvariantGlobalization. The crawler sets it repo-wide
         to drop libicu on the Pi, but CardStock formats currency for humans
         (docs/screens/screener.md:108). Copying it would change formatting
         silently: no error, no failing test. See ADR-0001 and D-070. -->
  </PropertyGroup>
</Project>
